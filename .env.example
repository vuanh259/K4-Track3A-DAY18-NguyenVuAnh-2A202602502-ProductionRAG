# Provider: auto (Gemini preferred), gemini, openai, or ollama.
LLM_PROVIDER=auto

# Copy to .env, then fill in your Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_MIN_REQUEST_INTERVAL_SECONDS=13

# Optional: used only when GEMINI_API_KEY is not set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Used when LLM_PROVIDER=ollama; no API key or network calls are required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
